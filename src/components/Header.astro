---
import { Image } from 'astro:assets';
import logo from '../assets/brand/ncmc-logo.png';
import Icon from './Icon.astro';
import { business, telHref } from '../data/business';
import { nav } from '../data/nav';
const path = Astro.url.pathname;
---
<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-white focus:p-3">Skip to content</a>
<header class="sticky top-0 z-40 border-b border-sand-200 bg-sand-50/95 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-3 md:h-20">
    <a href="/" class="flex shrink-0 items-center gap-2 no-underline" aria-label={`${business.name} home`}>
      <Image src={logo} alt="" width={56} height={55} densities={[1.5, 2, 3]} class="h-11 w-auto md:h-14" loading="eager" />
      <span class="hidden font-display text-xl font-bold leading-none text-navy-900 sm:block">NC Marine<br />Construction</span>
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-6 text-[0.95rem] font-medium">
        {nav.map((n) => (
          <li><a href={n.href} class:list={['py-2 no-underline hover:text-accent', path.startsWith(n.href) ? 'text-accent' : 'text-navy-900']} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href={telHref()} class="btn-primary px-3 sm:px-5" data-event="click_to_call" data-location="header">
        <Icon name="phone" /><span>{business.phones.office.display}</span>
      </a>
      <a href="/contact/#estimate" class="btn-secondary hidden md:inline-flex" data-event="estimate_cta" data-location="header">Free Estimate</a>
      <details class="relative lg:hidden">
        <summary class="btn list-none border-2 border-navy-900 px-3 text-navy-900 [&::-webkit-details-marker]:hidden" aria-label="Menu">Menu</summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-60 rounded-lg border border-sand-200 bg-white p-2 shadow-xl">
          <ul>
            {nav.map((n) => <li><a href={n.href} class="block min-h-11 rounded px-3 py-3 font-medium text-navy-900 no-underline hover:bg-sand-100">{n.label}</a></li>)}
            <li><a href="/contact/#estimate" class="mt-1 block min-h-11 rounded bg-accent px-3 py-3 font-semibold text-white no-underline">Free Estimate</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
