---
/**
 * Site header.
 * - solid (default): sticky bar on paper.
 * - overlay: transparent, white text, placed inside the home hero photo (SaaS-style).
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/ncmc-logo.png';
import Icon from './Icon.astro';
import { business, telHref } from '../data/business';
import { nav } from '../data/nav';

interface Props { variant?: 'solid' | 'overlay'; }
const { variant = 'solid' } = Astro.props;
const overlay = variant === 'overlay';
const path = Astro.url.pathname;
---
<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-sm focus:bg-card focus:p-3">Skip to content</a>
<header class:list={[overlay ? 'relative z-30' : 'sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur']}>
  <div class:list={['flex items-center justify-between gap-3', overlay ? 'container-x h-20' : 'container-x h-16 md:h-[4.5rem]']}>
    <a href="/" class="flex shrink-0 items-center gap-3 no-underline" aria-label={`${business.name} home`}>
      <Image src={logo} alt="" width={56} height={55} densities={[1.5, 2, 3]} class="h-11 w-auto invert md:h-12" loading="eager" />
      <span class:list={['hidden font-display text-lg font-semibold leading-tight sm:block', overlay ? 'text-white' : 'text-ink']}>NC Marine<br />Construction</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.95rem]">
        {nav.map((n) => {
          const on = path.startsWith(n.href);
          return (
            <li>
              <a
                href={n.href}
                aria-current={on ? 'page' : undefined}
                class:list={[
                  'py-2 no-underline transition-colors duration-200',
                  overlay ? 'text-white/85 hover:text-white' : on ? 'font-semibold text-ink' : 'text-ink/70 hover:text-ink',
                ]}
              >{n.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {!overlay && <a href="/contact/#estimate" class="btn-marker hidden md:inline-flex" data-event="estimate_cta" data-location="header">Free estimate</a>}
      <a
        href={telHref()}
        class:list={['btn px-4 sm:px-5', 'bg-white text-night hover:bg-marker']}
        data-event="click_to_call"
        data-location="header"
      >
        <Icon name="phone" /><span class="tabular-nums">{business.phones.office.display}</span>
      </a>
      <details class="relative lg:hidden">
        <summary class:list={['btn list-none px-3 [&::-webkit-details-marker]:hidden', overlay ? 'glass text-white' : 'border border-rule text-ink']} aria-label="Menu">Menu</summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-64 rounded-sm border border-rule bg-paper p-2 shadow-xl">
          <ul>
            {nav.map((n) => <li><a href={n.href} class="block min-h-11 rounded-sm px-3 py-3 font-medium text-ink no-underline hover:bg-shallow">{n.label}</a></li>)}
            <li><a href="/contact/#estimate" class="mt-1 block min-h-11 rounded-sm bg-marker px-3 py-3 font-semibold text-night no-underline">Free estimate</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
