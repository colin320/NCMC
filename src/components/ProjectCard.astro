---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
interface Props { href: string; title: string; town: string; summary: string; photo?: { src: ImageMetadata; alt: string }; }
const { href, title, town, summary, photo } = Astro.props;
---
<a href={href} class="group flex h-full flex-col overflow-hidden rounded-lg border border-sand-200 bg-white no-underline shadow-sm hover:border-accent">
  {photo ? <Image src={photo.src} alt={photo.alt} widths={[400, 740]} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[4/3] w-full object-cover" />
    : <div class="flex aspect-[4/3] items-center justify-center bg-navy-800 p-4 text-center text-sm text-navy-100">Project photos coming soon <span class="todo ml-1">TODO_CONFIRM: photos</span></div>}
  <div class="flex flex-1 flex-col p-5">
    <p class="eyebrow">{town}</p>
    <h3 class="mt-1 text-2xl group-hover:text-accent">{title}</h3>
    <p class="mt-2 flex-1 text-[0.95rem] text-muted">{summary}</p>
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent">View project<Icon name="arrow" class="h-4 w-4" /></span>
  </div>
</a>
