---
import Icon from './Icon.astro';
import { business, telHref } from '../data/business';
interface Props { heading?: string; text?: string; }
const { heading = 'Tell us what you want to do with your waterfront.', text = 'We come out, walk the shoreline with you, check the water depth and explain the permit path. The estimate is free.' } = Astro.props;
---
<section class="chart-grid bg-night text-white">
  <div class="container-x grid gap-8 py-16 md:grid-cols-[1.4fr_1fr] md:items-end md:py-20">
    <div>
      <p class="label-note text-marker">Free on-site estimate</p>
      <h2 class="mt-3 text-4xl text-white md:text-5xl">{heading}</h2>
      <p class="mt-4 max-w-[52ch] text-white/75">{text}</p>
    </div>
    <div class="flex flex-col gap-3 md:items-end">
      <a href={telHref()} class="btn-marker w-full text-lg md:w-auto" data-event="click_to_call" data-location="cta_band"><Icon name="phone" /><span class="tabular-nums">Call {business.phones.office.display}</span></a>
      <a href="/contact/#estimate" class="btn-ghost-light w-full md:w-auto" data-event="estimate_cta" data-location="cta_band">Request an estimate online</a>
    </div>
  </div>
</section>
