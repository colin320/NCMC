---
interface Props { items: { name: string; href: string }[]; }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="container-x pt-5 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((it, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1
          ? <span aria-current="page" class="text-ink">{it.name}</span>
          : <a href={it.href} class="underline-offset-2 hover:text-accent hover:underline">{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
