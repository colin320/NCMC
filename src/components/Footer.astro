---
import { getCollection } from 'astro:content';
import Fact from './Fact.astro';
import { business, telHref, isConfirmed } from '../data/business';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const B = business;
const year = new Date().getFullYear();
---
<footer class="bg-navy-950 pb-20 text-navy-100 md:pb-0">
  <div class="container-x grid gap-10 py-12 md:grid-cols-4">
    <div class="md:col-span-1">
      <p class="font-display text-2xl font-bold text-white">{B.name}</p>
      <p class="mt-2 text-sm">{B.positioning}. {B.differentiator}.</p>
      <p class="mt-3 text-sm"><strong class="text-white">Licensed &amp; Insured</strong><br />NC GC License #<Fact value={B.license.number} /></p>
    </div>
    <div>
      <h2 class="text-lg text-white">Contact</h2>
      <address class="mt-3 space-y-1 text-sm not-italic">
        <p class="font-semibold text-white">{B.legalName}</p>
        <p><Fact value={B.address.street} /><br /><Fact value={B.address.city} />, {B.address.region} <Fact value={B.address.postalCode} /></p>
        <p><a class="text-white underline" href={telHref()} data-event="click_to_call" data-location="footer">{B.phones.office.display}</a></p>
        {B.phones.publishMobile && <p>Mobile: <a class="text-white underline" href={telHref(B.phones.mobile)} data-event="click_to_call" data-location="footer_mobile">{B.phones.mobile.display}</a></p>}
        <p><a class="text-white underline" href={`mailto:${B.email}`}>{B.email}</a></p>
      </address>
      <h3 class="mt-4 text-base text-white">Hours</h3>
      {B.hours.length ? (
        <ul class="text-sm">{B.hours.map((h) => <li>{h.days}: {h.opens} to {h.closes}</li>)}</ul>
      ) : <p class="text-sm"><Fact value={B.hoursText} /></p>}
    </div>
    <div>
      <h2 class="text-lg text-white">Services</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {services.map((s) => <li><a class="text-navy-100 hover:text-white" href={`/services/${s.id}/`}>{s.data.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-lg text-white">Service Area</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {B.areas.map((a) => <li>{a.areaPage ? <a class="hover:text-white" href={a.areaPage}>{a.name}, NC</a> : <span>{a.name}, NC</span>}</li>)}
      </ul>
      {!B.areasConfirmed && <p class="mt-2 text-sm"><span class="todo">TODO_CONFIRM: town list</span></p>}
      <ul class="mt-4 flex gap-4 text-sm">
        <li><a class="text-white underline" href={B.social.facebook} rel="me noopener" target="_blank">Facebook</a></li>
        <li><a class="text-white underline" href={B.social.instagram} rel="me noopener" target="_blank">Instagram</a></li>
        {isConfirmed(B.social.googleBusinessProfile) && <li><a class="text-white underline" href={B.social.googleBusinessProfile} rel="me noopener" target="_blank">Google</a></li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-navy-800">
    <div class="container-x flex flex-col gap-2 py-5 text-xs sm:flex-row sm:justify-between">
      <p>&copy; {year} {B.legalName}. All rights reserved.</p>
      <p><a class="hover:text-white" href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>
