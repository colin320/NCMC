---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../assets/brand/ncmc-logo.png';
import Fact from './Fact.astro';
import { business, telHref, isConfirmed } from '../data/business';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const B = business;
const year = new Date().getFullYear();
const h = 'label-note text-white/60';
---
<footer class="bg-ink pb-20 text-white/80 md:pb-0">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <Image src={logo} alt="NC Marine Construction seal" width={96} height={95} densities={[1.5, 2]} class="h-24 w-auto invert" />
      <p class="mt-5 text-sm">{B.positioning}. {B.differentiator}.</p>
      <p class="mt-3 font-mono text-xs uppercase tracking-[0.1em]">NC GC Lic. #<Fact value={B.license.number} /></p>
    </div>
    <div>
      <h2 class={h}>Contact</h2>
      <address class="mt-4 space-y-2 text-sm not-italic">
        <p class="font-semibold text-white">{B.legalName}</p>
        <p><Fact value={B.address.street} /><br /><Fact value={B.address.city} />, {B.address.region} <Fact value={B.address.postalCode} /></p>
        <p><a class="font-display text-xl font-bold text-white no-underline tabular-nums hover:underline" href={telHref()} data-event="click_to_call" data-location="footer">{B.phones.office.display}</a></p>
        {B.phones.publishMobile && <p>Mobile: <a class="text-white underline" href={telHref(B.phones.mobile)} data-event="click_to_call" data-location="footer_mobile">{B.phones.mobile.display}</a></p>}
        <p><a class="text-white underline underline-offset-2" href={`mailto:${B.email}`}>{B.email}</a></p>
      </address>
      <h2 class={`${h} mt-6`}>Hours</h2>
      {B.hours.length ? (
        <ul class="mt-2 text-sm">{B.hours.map((x) => <li>{x.days}: {x.opens} to {x.closes}</li>)}</ul>
      ) : <p class="mt-2 text-sm"><Fact value={B.hoursText} /></p>}
    </div>
    <div>
      <h2 class={h}>Services</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {services.map((s) => <li><a class="text-white/80 no-underline hover:text-white hover:underline" href={`/services/${s.id}/`}>{s.data.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class={h}>Service area</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {B.areas.map((a) => <li>{a.areaPage ? <a class="hover:text-white" href={a.areaPage}>{a.name}</a> : <span>{a.name}</span>}</li>)}
      </ul>
      {!B.areasConfirmed && <p class="mt-2 text-sm"><span class="todo">TODO_CONFIRM: town list</span></p>}
      <ul class="mt-6 flex gap-5 text-sm">
        <li><a class="text-white underline underline-offset-2" href={B.social.facebook} rel="me noopener" target="_blank">Facebook</a></li>
        <li><a class="text-white underline underline-offset-2" href={B.social.instagram} rel="me noopener" target="_blank">Instagram</a></li>
        {isConfirmed(B.social.googleBusinessProfile) && <li><a class="text-white underline underline-offset-2" href={B.social.googleBusinessProfile} rel="me noopener" target="_blank">Google</a></li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="container-x flex flex-col gap-2 py-5 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-white/60 sm:flex-row sm:justify-between">
      <p>&copy; {year} {B.legalName}</p>
      <p><a class="text-white/60 no-underline hover:text-white" href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>
