---
/**
 * Illustrative plan-view schematic of the North Topsail Beach project, drawn only from
 * the verified spec list (300 ft seawall, 250 ft dock with bridge section, elevator lift,
 * 1,500 lb PWC swinger lift, WaveArmor float). NOT the as-built layout; labeled as such.
 * [CONFIRM] Replace or adjust once the owner shares the real plan or drone photo.
 */
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<figure class={cls}>
  <svg viewBox="0 0 640 470" role="img" aria-labelledby="plan-title plan-desc" class="h-auto w-full" font-family="'Inter Variable', ui-sans-serif, sans-serif">
    <title id="plan-title">Plan schematic of the North Topsail Beach project</title>
    <desc id="plan-desc">Top-down schematic: a 300 foot vinyl seawall along the shoreline, a 250 foot dock running out from it with a bridge section for navigation, and at the end an elevator boat lift, a 1,500 pound PWC swinger lift and a WaveArmor jet ski float.</desc>
    <defs>
      <pattern id="land" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="#1c1917" stroke-opacity="0.18" stroke-width="1.2" />
      </pattern>
      <marker id="tick" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="8" markerHeight="8" orient="auto">
        <line x1="2" y1="8" x2="8" y2="2" stroke="#134e4a" stroke-width="1.6" />
      </marker>
    </defs>

    <!-- water -->
    <rect x="0" y="0" width="640" height="470" fill="#eef3f2" />
    <g stroke="#134e4a" stroke-opacity="0.18" fill="none" stroke-width="1">
      <path d="M20 250 q20 -6 40 0 t40 0" /><path d="M420 300 q20 -6 40 0 t40 0" />
      <path d="M60 380 q20 -6 40 0 t40 0" /><path d="M470 420 q20 -6 40 0 t40 0" />
      <path d="M150 320 q20 -6 40 0 t40 0" />
    </g>

    <!-- land -->
    <rect x="0" y="0" width="640" height="120" fill="#ffffff" />
    <rect x="0" y="0" width="640" height="120" fill="url(#land)" />
    <text x="24" y="40" font-size="11" fill="#1c1917" letter-spacing="1.5">UPLAND / PROPERTY</text>

    <!-- seawall -->
    <line x1="40" y1="120" x2="600" y2="120" stroke="#1c1917" stroke-width="5" />
    <line x1="40" y1="112" x2="40" y2="96" stroke="#1c1917" stroke-width="5" />
    <line x1="600" y1="112" x2="600" y2="96" stroke="#1c1917" stroke-width="5" />
    <!-- seawall dimension -->
    <line x1="40" y1="76" x2="600" y2="76" stroke="#134e4a" stroke-width="1.2" marker-start="url(#tick)" marker-end="url(#tick)" />
    <rect x="198" y="66" width="244" height="20" fill="#ffffff" />
    <text x="320" y="80" font-size="11.5" fill="#134e4a" text-anchor="middle" letter-spacing="1">300 LF CMI VINYL SEAWALL</text>

    <!-- dock walkway -->
    <g fill="#ffffff" stroke="#1c1917" stroke-width="2">
      <rect x="300" y="120" width="28" height="95" />
      <rect x="300" y="255" width="28" height="105" />
    </g>
    <!-- bridge section -->
    <g stroke="#1c1917" stroke-width="2" fill="none">
      <line x1="300" y1="215" x2="300" y2="255" stroke-dasharray="4 3" />
      <line x1="328" y1="215" x2="328" y2="255" stroke-dasharray="4 3" />
    </g>
    <line x1="338" y1="235" x2="420" y2="235" stroke="#134e4a" stroke-width="1" />
    <text x="426" y="231" font-size="11" fill="#1c1917" letter-spacing="1">BRIDGE SECTION</text>
    <text x="426" y="246" font-size="10" fill="#57534e" letter-spacing="1">FOR NAVIGATION</text>

    <!-- terminal platform -->
    <rect x="250" y="360" width="128" height="34" fill="#ffffff" stroke="#1c1917" stroke-width="2" />

    <!-- elevator lift slip (left) -->
    <rect x="196" y="300" width="48" height="94" fill="none" stroke="#1c1917" stroke-width="1.5" stroke-dasharray="6 4" />
    <path d="M208 386 L208 320 Q220 302 232 320 L232 386 Z" fill="#134e4a" fill-opacity="0.2" stroke="#134e4a" stroke-width="1.2" />
    <line x1="196" y1="296" x2="120" y2="262" stroke="#134e4a" stroke-width="1" />
    <text x="24" y="250" font-size="11" fill="#1c1917" letter-spacing="1">ELEVATOR DOCK LIFT</text>

    <!-- PWC swinger lift (right) -->
    <rect x="384" y="368" width="34" height="20" fill="#134e4a" fill-opacity="0.2" stroke="#134e4a" stroke-width="1.2" />
    <circle cx="384" cy="378" r="4" fill="#1c1917" />
    <line x1="418" y1="378" x2="460" y2="350" stroke="#134e4a" stroke-width="1" />
    <text x="466" y="340" font-size="11" fill="#1c1917" letter-spacing="1">1,500 LB PWC</text>
    <text x="466" y="355" font-size="11" fill="#1c1917" letter-spacing="1">SWINGER LIFT</text>

    <!-- WaveArmor float -->
    <rect x="300" y="400" width="30" height="40" fill="#ffffff" stroke="#1c1917" stroke-width="1.5" />
    <line x1="330" y1="430" x2="460" y2="430" stroke="#134e4a" stroke-width="1" />
    <text x="466" y="426" font-size="11" fill="#1c1917" letter-spacing="1">WAVEARMOR</text>
    <text x="466" y="441" font-size="11" fill="#1c1917" letter-spacing="1">JET SKI FLOAT</text>

    <!-- dock dimension -->
    <line x1="280" y1="124" x2="280" y2="390" stroke="#134e4a" stroke-width="1.2" marker-start="url(#tick)" marker-end="url(#tick)" />
    <g transform="translate(270 292) rotate(-90)">
      <rect x="-52" y="-12" width="104" height="18" fill="#eef3f2" />
      <text x="0" y="2" font-size="11.5" fill="#134e4a" text-anchor="middle" letter-spacing="1">250 FT DOCK</text>
    </g>

    <text x="616" y="458" font-size="9.5" fill="#57534e" text-anchor="end" letter-spacing="1">SCHEMATIC · NOT TO SCALE</text>
  </svg>
  <figcaption class="mt-3 font-mono text-xs text-muted">Illustrative schematic drawn from the project spec list, not the as-built plan. <span class="todo">TODO_CONFIRM: replace with real plan or drone photo</span></figcaption>
</figure>
