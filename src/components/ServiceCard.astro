---
import Icon from './Icon.astro';
interface Props { href: string; name: string; summary: string; }
const { href, name, summary } = Astro.props;
---
<a href={href} class="group flex h-full flex-col rounded-lg border border-sand-200 bg-white p-5 no-underline shadow-sm transition hover:border-accent hover:shadow-md">
  <h3 class="text-2xl text-navy-900 group-hover:text-accent">{name}</h3>
  <p class="mt-2 flex-1 text-[0.95rem] text-muted">{summary}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent">Learn more<span class="sr-only"> about {name}</span><Icon name="arrow" class="h-4 w-4" /></span>
</a>
