---
import Icon from './Icon.astro';
interface Props { href: string; name: string; summary: string; }
const { href, name, summary } = Astro.props;
---
<a href={href} class="group flex h-full flex-col rounded-sm border border-rule bg-white p-6 no-underline transition-colors duration-200 hover:border-brass">
  <h3 class="text-xl">{name}</h3>
  <p class="mt-2 flex-1 text-[0.95rem] text-muted">{summary}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brass">Learn more<span class="sr-only"> about {name}</span><Icon name="arrow" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" /></span>
</a>
