---
import Icon from './Icon.astro';
interface Props { href: string; name: string; summary: string; }
const { href, name, summary } = Astro.props;
---
<a href={href} class="group flex h-full flex-col gap-2 border-t border-ink py-5 pr-2 no-underline">
  <h3 class="flex items-start justify-between gap-3 text-xl text-ink">
    <span class="group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{name}</span>
    <Icon name="arrow" class="mt-1 h-5 w-5 shrink-0 text-tide transition-transform group-hover:translate-x-1" />
  </h3>
  <p class="text-[0.95rem] text-muted">{summary}</p>
</a>
