---
/**
 * Estimate request form. Posts to the Cloudflare Pages Function at /api/estimate
 * (functions/api/estimate.ts), which forwards to the GHL webhook and copies the lead
 * to the Dyno inbox. Works without JS (plain POST + 303 redirect); JS adds inline
 * validation and a clear error state so a lead never fails silently.
 */
import { business, integrations, telHref } from '../data/business';
import { projectTypes } from '../data/form';

interface Props {
  variant?: 'full' | 'short';
  /** Pre-checked project type value on service pages */
  preselect?: string;
  id?: string;
}
const { variant = 'full', preselect, id = 'estimate' } = Astro.props;
const full = variant === 'full';
const towns = [...business.areas.map((a) => a.name), 'Other / not listed'];
const uid = `${id}-f`;
const { turnstileSiteKey } = integrations;
const field = 'mt-1 block min-h-11 w-full rounded-sm border border-ink/20 bg-paper px-3 py-2 text-base text-ink placeholder:text-muted focus:border-sea';
const label = 'block text-sm font-semibold text-ink';
---
<form id={id} action="/api/estimate" method="post" class="estimate-form space-y-5 rounded-sm border border-rule bg-card p-5  md:p-7" novalidate>
  <div>
    <h2 class="text-3xl">Request a free estimate</h2>
    <p class="mt-1 text-sm text-muted">This takes about a minute. If you'd rather talk, call <a href={telHref()} class="font-semibold text-sea underline" data-event="click_to_call" data-location="form">{business.phones.office.display}</a>.</p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for={`${uid}-name`} class={label}>Name <span aria-hidden="true">*</span></label>
      <input id={`${uid}-name`} name="name" type="text" autocomplete="name" required class={field} />
      <p class="field-error mt-1 hidden text-sm text-red-300" id={`${uid}-name-err`}>Please enter your name.</p>
    </div>
    <div>
      <label for={`${uid}-phone`} class={label}>Phone <span aria-hidden="true">*</span></label>
      <input id={`${uid}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9()+\-.\s]{10,}" class={field} />
      <p class="field-error mt-1 hidden text-sm text-red-300" id={`${uid}-phone-err`}>Please enter a phone number we can reach you at.</p>
    </div>
    <div>
      <label for={`${uid}-email`} class={label}>Email{full && <Fragment> <span aria-hidden="true">*</span></Fragment>}</label>
      <input id={`${uid}-email`} name="email" type="email" autocomplete="email" required={full} class={field} />
      <p class="field-error mt-1 hidden text-sm text-red-300" id={`${uid}-email-err`}>Please enter a valid email.</p>
    </div>
    <div>
      <label for={`${uid}-town`} class={label}>Property town <span aria-hidden="true">*</span></label>
      <select id={`${uid}-town`} name="town" required class={field}>
        <option value="">Select a town</option>
        {towns.map((t) => <option value={t}>{t}</option>)}
      </select>
      <p class="field-error mt-1 hidden text-sm text-red-300" id={`${uid}-town-err`}>Please choose a town.</p>
    </div>
  </div>

  <fieldset>
    <legend class={label}>Project type (choose any)</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      {projectTypes.map((p) => (
        <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-sm border border-rule px-3 py-2 hover:bg-shallow">
          <input type="checkbox" name="projectType" value={p.value} checked={p.value === preselect} class="h-5 w-5 accent-marker" />
          <span>{p.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div>
    <label for={`${uid}-desc`} class={label}>Tell us about the project</label>
    <textarea id={`${uid}-desc`} name="description" rows={full ? 4 : 3} maxlength="2000" class={field} placeholder="Example: replace an old fixed pier and add a lift for a 24 ft center console"></textarea>
  </div>

  {full && (
    <fieldset>
      <legend class={label}>Best way to reach you</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {['Call', 'Text', 'Email'].map((m, i) => (
          <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-sm border border-rule px-3 py-2 hover:bg-shallow">
            <input type="radio" name="contactMethod" value={m} checked={i === 0} class="h-5 w-5 accent-marker" />{m}
          </label>
        ))}
      </div>
    </fieldset>
  )}

  <label class="flex cursor-pointer items-start gap-3 text-sm">
    <input type="checkbox" name="smsConsent" value="yes" class="mt-0.5 h-5 w-5 shrink-0 accent-marker" />
    <span><span class="todo">TODO_CONFIRM: SMS consent wording per counsel</span> I agree to receive text messages from {business.name} about my estimate. Message and data rates may apply. Reply STOP to opt out.</span>
  </label>

  <!-- Honeypot: hidden from people, bots fill it -->
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for={`${uid}-company`}>Company</label>
    <input id={`${uid}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="page" value={Astro.url.pathname} />
  {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-appearance="interaction-only"></div>}

  <div class="form-status hidden rounded-sm border-l-4 border-red-600 bg-red-950/50 p-3 text-sm" role="alert"></div>

  <button type="submit" class="btn-primary w-full text-lg sm:w-auto">Send my estimate request</button>
  <p class="text-xs text-muted">We use your details only to respond to this request. See our <a href="/privacy/" class="underline">privacy policy</a>.</p>
</form>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { business } from '../data/business';
  const phone = business.phones.office.display;
  const tel = business.phones.office.e164;

  document.querySelectorAll<HTMLFormElement>('form.estimate-form').forEach((form) => {
    // Prefill from the home hero quick-estimate bar (/contact/?project=dock&town=Surf+City).
    const params = new URLSearchParams(location.search);
    const project = params.get('project');
    const town = params.get('town');
    if (project) form.querySelectorAll<HTMLInputElement>('input[name=projectType]').forEach((c) => { if (c.value === project) c.checked = true; });
    if (town) {
      const sel = form.querySelector<HTMLSelectElement>('select[name=town]');
      if (sel && [...sel.options].some((o) => o.value === town)) sel.value = town;
    }

    const status = form.querySelector<HTMLElement>('.form-status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    const showFieldError = (input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      const err = form.querySelector<HTMLElement>(`#${input.id}-err`);
      const bad = !input.checkValidity();
      input.setAttribute('aria-invalid', String(bad));
      if (err) {
        err.classList.toggle('hidden', !bad);
        if (bad) input.setAttribute('aria-describedby', err.id);
      }
      return !bad;
    };

    form.querySelectorAll<HTMLInputElement>('input[required], select[required], input[type=email]').forEach((el) =>
      el.addEventListener('blur', () => showFieldError(el)),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.classList.add('hidden');
      const inputs = [...form.querySelectorAll<HTMLInputElement>('input[required], select[required], input[type=email]')];
      const results = inputs.map(showFieldError);
      const firstBad = inputs[results.indexOf(false)];
      if (firstBad) { firstBad.focus(); return; }

      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'send_failed');
        window.location.href = '/thank-you/';
      } catch {
        status.innerHTML = `Sorry, your request did not go through. Please call us at <a class="font-semibold underline" href="tel:${tel}">${phone}</a> or try again.`;
        status.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Send my estimate request';
      }
    });
  });
</script>
