---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { generalFaqs, permitFaqs, processFaqs } from '../data/faqs';
import { faqSchema } from '../lib/schema';
---
<BaseLayout
  title="Dock, Lift & Seawall FAQ | NC Marine Construction"
  description="Answers about docks, boat lifts, seawalls and CAMA permits on the southeastern NC coast. Call (910) 465-1712 for a free estimate."
  breadcrumbs={[{ name: 'FAQ', href: '/faq/' }]}
  schema={[faqSchema([...generalFaqs, ...permitFaqs, ...processFaqs])]}
>
  <section class="container-x py-10 md:py-14">
    <h1 class="text-4xl md:text-6xl">Frequently Asked Questions</h1>
    <p class="answer-first mt-5">Straight answers to the questions waterfront homeowners in Wilmington and coastal North Carolina ask us most about docks, boat lifts, seawalls, permits and the estimate process. If your question is not here, call us and we will answer it.</p>
    <div class="mt-12 space-y-14">
      <FaqList faqs={generalFaqs} heading="General" />
      <div id="permits">
        <FaqList faqs={permitFaqs} heading="Permits (CAMA)" />
        <p class="mt-4 max-w-3xl text-sm text-muted">Permit information is general and not legal advice. Rules change, so confirm with the <a class="underline" href="https://www.deq.nc.gov/about/divisions/coastal-management" rel="noopener">NC Division of Coastal Management</a> or ask us during your site visit. Source: <a class="underline" href="https://deq.nc.gov/sl-2024-53-gis-link/open" rel="noopener">NC DCM replacement exemption (S.L. 2024-53)</a>. Last updated November 2026.</p>
      </div>
      <FaqList faqs={processFaqs} heading="Process & timing" />
    </div>
  </section>
  <CtaBand />
</BaseLayout>
