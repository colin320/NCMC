---
/**
 * Home, v5: "SaaS company meets construction".
 * Dark theme. Full-bleed photo hero with the nav overlaid: headline, glass estimate bar,
 * credentials, and a spec-sheet card listing only what is visible in the photo.
 * Then: supplier strip (SaaS "trusted by" row, from verified project credits), service
 * feature cards with clean photos, fixed-vs-floating comparison table, recent-work slider,
 * process, towns, FAQ, estimate card.
 * Skill patterns (UI/UX Pro Max): Bento Grid Showcase, Comparison Table ("be factual"),
 * Trust & Authority. See docs/DESIGN.md.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import FaqList from '../components/FaqList.astro';
import EstimateForm from '../components/EstimateForm.astro';
import GallerySlider from '../components/GallerySlider.astro';
import { business, telHref, isConfirmed } from '../data/business';
import { homeFaqs } from '../data/faqs';
import { gallery } from '../data/gallery';
import { projectTypes } from '../data/form';
import { faqSchema, imageGallerySchema } from '../lib/schema';
import { galleryImageUrls } from '../lib/gallery-images';

const B = business;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const project = (await getCollection('projects')).find((p) => p.id === 'north-topsail-beach-seawall-dock-lifts');
const byFile = (name: string) => gallery.find((g) => g.src.src.includes(name))!;
const hero = byFile('twin-boat-lifts');
const slides = [
  'long-pier-covered-platform', 'fixed-pier-gangway', 'boat-lifts-side-view', 'pier-bench-railing', 'pier-walkway-decking',
  'pier-gazebo-marsh', 'covered-pier-composite', 'custom-dock-cabinet', 'covered-pier-gazebo-vinyl', 'twin-boat-lifts',
].map(byFile);
const galleryLd = imageGallerySchema('Recent work by NC Marine Construction', new URL('/', Astro.site).toString(), await galleryImageUrls(Astro.site!));

// Feature cards: every service gets a real photo where we have one that shows it.
const servicePhotos: Record<string, ReturnType<typeof byFile>> = {
  'docks-piers': byFile('pier-gazebo-marsh'),
  'floating-docks': byFile('fixed-pier-gangway'),
  'boat-lifts': byFile('boat-lifts-side-view'),
  'seawalls-bulkheads': byFile('covered-pier-gazebo-vinyl'),
  'dock-repair': byFile('pier-walkway-decking'),
  pilings: byFile('covered-pier-composite'),
};

// Supplier strip: names from the verified North Topsail project credits.
const suppliers = project?.data.suppliers.map((s) => s.replace(/\s*\(.*\)$/, '')) ?? [];

// Spec card: only what is visible in the hero photo.
const heroSpecs = [
  { k: 'Boat lifts', v: '2' },
  { k: 'Decking', v: 'Composite' },
  { k: 'Walkway', v: 'Grated center strip' },
];

const steps = [
  { t: 'Site visit', d: 'We come out and talk through how you want to use the water, and what you want the dock to do.', tag: 'Free' },
  { t: 'Price', d: 'You get a price for that dock before you commit.' },
  { t: 'Build', d: 'We build the dock so it looks right with the house and works for the boat.' },
  { t: 'Walk-through', d: 'We walk the finished dock with you so you can start using it.' },
];

// Comparison facts: same statements as the Floating Docks and Docks & Piers pages.
const compare = [
  { k: 'How it sits', fixed: 'On pilings at one height', floating: 'On floats, rises and falls with the tide' },
  { k: 'Step down to the boat', fixed: 'Changes with the tide', floating: 'Same at every tide' },
  { k: 'Best for', fixed: 'Piers, platforms and boat lifts', floating: 'Low boats, kayaks, paddleboards and jet skis' },
  { k: 'Often paired with', fixed: 'A floating dock on a gangway', floating: 'A fixed pier and gangway' },
];

const quickTypes = projectTypes.filter((p) => p.value !== 'other');
---
<BaseLayout
  title="Dock & Boat Lift Builder | Topsail Island & Hampstead, NC"
  description="Docks, boat lifts and seawalls for waterfront homes in Surf City, Hampstead, Topsail Beach and North Topsail Beach. Licensed and insured. (910) 465-1712"
  schema={[faqSchema(homeFaqs), galleryLd]}
  overlayHeader
>
  <!-- 1. Photo hero with overlay nav -->
  <!-- Mobile: the photo is a fixed-height band behind the nav + headline (a full-height
       background would crop a 4:3 photo into a tall strip and upscale it past its
       resolution). Desktop (lg): photo fills the whole hero. -->
  <section class="relative isolate overflow-hidden bg-paper lg:bg-night">
    <div class="absolute inset-x-0 top-0 -z-10 h-[34rem] sm:h-[38rem] lg:inset-0 lg:h-auto">
      <Image src={hero.src} alt={hero.alt} widths={[828, 1280, 1600, 2000]} sizes="(min-width: 1024px) 100vw, (min-width: 640px) 820px, 740px" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[50%_45%]" />
      <div class="absolute inset-0 bg-gradient-to-b from-night/60 via-night/30 to-paper" aria-hidden="true"></div>
      <div class="absolute inset-0 hidden bg-gradient-to-r from-night/80 via-night/30 to-transparent lg:block" aria-hidden="true"></div>
    </div>

    <Header variant="overlay" />

    <div class="container-x grid gap-10 pb-16 pt-14 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:pb-24 lg:pt-28">
      <div class="min-w-0">
        <h1 class="text-[2.6rem] font-semibold leading-[1.02] text-white sm:text-6xl lg:text-[4.1rem]">Docks, boat lifts and seawalls on Topsail Island and in Hampstead</h1>
        <p class="mt-6 max-w-[46ch] text-lg text-white/85">We're a licensed and insured marine contractor building docks, piers and boat lifts for waterfront homes in Surf City, Hampstead, Topsail Beach and North Topsail Beach.</p>

        <form action="/contact/" method="get" class="glass mt-8 grid gap-1 rounded-[16px] p-2 text-white sm:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)_auto] sm:items-stretch lg:max-w-[640px]" aria-label="Start a free estimate">
          <label for="hero-project" class="flex flex-col px-3 py-2 sm:border-r sm:border-white/20">
            <span class="text-xs text-white/75">Project</span>
            <span class="relative block">
              <select id="hero-project" name="project" class="mt-0.5 min-h-8 w-full appearance-none bg-transparent pr-8 font-medium text-white outline-none [&>option]:bg-night">
                {quickTypes.map((t) => <option value={t.value}>{t.label}</option>)}
              </select>
              <Icon name="chevron" class="pointer-events-none absolute right-1 top-1/2 h-4 w-4 -translate-y-1/2 text-white/75" />
            </span>
          </label>
          <label for="hero-town" class="flex flex-col px-3 py-2">
            <span class="text-xs text-white/75">Property town</span>
            <span class="relative block">
              <select id="hero-town" name="town" class="mt-0.5 min-h-8 w-full appearance-none bg-transparent pr-8 font-medium text-white outline-none [&>option]:bg-night">
                {B.areas.map((a) => <option value={a.name}>{a.name}</option>)}
              </select>
              <Icon name="chevron" class="pointer-events-none absolute right-1 top-1/2 h-4 w-4 -translate-y-1/2 text-white/75" />
            </span>
          </label>
          <button type="submit" class="btn-primary" data-event="estimate_cta" data-location="hero_bar">Get free estimate</button>
        </form>
        <p class="mt-4 text-sm text-white/80">Prefer to talk? Call <a href={telHref()} class="font-semibold text-white underline underline-offset-2" data-event="click_to_call" data-location="hero">{B.phones.office.display}</a></p>

        <dl class="mt-10 grid max-w-[640px] grid-cols-3 gap-4 border-t border-white/15 pt-6 text-sm">
          <div><dt class="text-white/65">License</dt><dd class="mt-1 font-semibold text-white">{isConfirmed(B.license.number) ? `NC GC #${B.license.number}` : <span class="todo">TODO_CONFIRM</span>}</dd></div>
          <div><dt class="text-white/65">Insured</dt><dd class="mt-1 font-semibold text-white">Fully insured</dd></div>
          <div><dt class="text-white/65">Since</dt><dd class="mt-1 font-semibold text-white">{isConfirmed(B.yearFounded) ? B.yearFounded : <span class="todo">TODO_CONFIRM</span>}</dd></div>
        </dl>
      </div>

      <!-- Spec sheet card: only what is visible in the photo -->
      <a href="/services/boat-lifts/" class="group block w-full max-w-sm rounded-[18px] border border-white/15 bg-night/70 p-5 text-white no-underline backdrop-blur-md transition-colors duration-200 hover:bg-night/85 lg:justify-self-end">
        <span class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-[0.12em] text-marker">Recent build</span>
          <Icon name="arrow" class="h-4 w-4 -rotate-45 transition-transform duration-200 group-hover:rotate-0" />
        </span>
        <span class="mt-2 block font-display text-2xl font-semibold">Twin boat lifts</span>
        <span class="block text-sm text-white/70">{hero.town}, NC</span>
        <span class="mt-4 block divide-y divide-white/10 border-t border-white/10 text-sm">
          {heroSpecs.map((r) => <span class="flex justify-between gap-4 py-2"><span class="text-white/65">{r.k}</span><span class="font-medium">{r.v}</span></span>)}
        </span>
      </a>
    </div>
  </section>

  <!-- 2. Supplier strip -->
  {suppliers.length > 0 && (
    <section aria-labelledby="suppliers-heading" class="border-b border-rule bg-card">
      <div class="container-x flex flex-col gap-4 py-8 md:flex-row md:items-center md:gap-10">
        <h2 id="suppliers-heading" class="shrink-0 font-sans text-sm font-medium tracking-normal text-muted">Materials &amp; suppliers on recent projects</h2>
        <ul class="flex flex-wrap items-center gap-x-10 gap-y-3">
          {suppliers.map((s) => <li class="font-display text-xl font-semibold tracking-tight text-ink/55">{s}</li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- 3. Services: feature cards with clean photos -->
  <section class="container-x py-20 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-[18ch] text-4xl md:text-5xl">What we build</h2>
      <a href="/services/" class="btn-secondary">All services</a>
    </div>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => {
        const ph = servicePhotos[s.id];
        return (
          <li>
            <a href={`/services/${s.id}/`} class="group flex h-full flex-col overflow-hidden rounded-[18px] border border-rule bg-card no-underline transition-shadow duration-200 hover:shadow-[0_12px_40px_rgb(28_25_23/0.10)]">
              {ph ? (
                <Image src={ph.src} alt={ph.alt} widths={[400, 740]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="aspect-[16/10] w-full object-cover" />
              ) : (
                <span class="drafting-grid flex aspect-[16/10] w-full items-center justify-center bg-shallow p-5 text-sm text-muted">
                  Project photos coming soon
                </span>
              )}
              <span class="flex flex-1 flex-col p-5">
                <span class="flex items-start justify-between gap-3">
                  <h3 class="text-xl">{s.data.name}</h3>
                  <Icon name="arrow" class="mt-1 h-4 w-4 shrink-0 -rotate-45 text-sea transition-transform duration-200 group-hover:rotate-0" />
                </span>
                <p class="mt-2 text-[0.95rem] text-muted">{s.data.cardSummary}</p>
              </span>
            </a>
          </li>
        );
      })}
      <li class="lg:col-span-2">
        <a href="#estimate" class="flex h-full min-h-56 flex-col justify-between rounded-[18px] bg-night p-6 text-white no-underline" data-event="estimate_cta" data-location="services_card">
          <span class="font-display text-2xl font-semibold leading-tight">Request a free estimate</span>
          <span>
            <span class="block text-white/80">Tell us how you want to use the water, and we'll come look.</span>
            <span class="btn-marker mt-5">Request a free estimate</span>
          </span>
        </a>
      </li>
    </ul>
  </section>

  <!-- 4. Comparison table -->
  <section class="bg-shallow">
    <div class="container-x grid gap-10 py-20 md:py-24 lg:grid-cols-[0.8fr_1.4fr] lg:items-start">
      <div>
        <h2 class="text-4xl md:text-5xl">Fixed dock or floating dock?</h2>
        <p class="mt-4 max-w-[40ch] text-muted">A fixed dock is where you sit and how you reach the boat. A floating dock moves with the tide, so getting on and off stays easy. A lot of homes use both.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/services/docks-piers/" class="link">Fixed docks &amp; piers</a>
          <a href="/services/floating-docks/" class="link">Floating docks</a>
        </div>
      </div>
      <div class="min-w-0 overflow-x-auto rounded-[18px] border border-rule bg-card">
        <table class="w-full min-w-[34rem] text-left text-[0.95rem]">
          <caption class="sr-only">Fixed dock compared with floating dock</caption>
          <thead>
            <tr class="border-b border-rule">
              <th scope="col" class="w-[30%] p-4 font-medium text-muted"><span class="sr-only">Feature</span></th>
              <th scope="col" class="p-4 font-display text-lg font-semibold">Fixed dock</th>
              <th scope="col" class="bg-white/[0.04] p-4 font-display text-lg font-semibold">Floating dock</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((r) => (
              <tr class="border-b border-rule last:border-0">
                <th scope="row" class="p-4 font-medium text-muted">{r.k}</th>
                <td class="p-4">{r.fixed}</td>
                <td class="bg-white/[0.04] p-4">{r.floating}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. Recent work -->
  <section class="container-x py-20 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-4xl md:text-5xl">Recent docks and lifts</h2>
      <a href="/projects/" class="link">See all projects</a>
    </div>
    <div class="mt-6">
      <GallerySlider photos={slides} id="home-gallery" label="Recent work" />
    </div>
    <p class="mt-2 text-sm"><span class="todo">TODO_CONFIRM: every photo is NCMC's own work (and photographer permission where needed)</span></p>
  </section>

  <!-- 6. Process -->
  <section class="border-t border-rule">
    <div class="container-x py-20 md:py-24">
      <h2 class="max-w-[20ch] text-4xl md:text-5xl">How a job goes</h2>
      <ol class="relative mt-12 grid gap-4 md:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-[18px] border border-rule bg-card p-6">
            <span class="flex items-center justify-between">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-night font-display text-sm font-semibold text-white">{i + 1}</span>
              {s.tag && <span class="rounded-full bg-marker px-2.5 py-0.5 text-xs font-semibold text-night">{s.tag}</span>}
            </span>
            <h3 class="mt-5 text-xl">{s.t}</h3>
            <p class="mt-2 text-[0.95rem] text-muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 7. Towns -->
  <section class="container-x pb-20 md:pb-24">
    <div class="grid gap-8 rounded-[22px] bg-tide px-6 py-12 text-white sm:px-10 md:grid-cols-[1fr_1.4fr] md:py-14">
      <div>
        <h2 class="text-3xl text-white md:text-4xl">Where we build</h2>
        <p class="mt-4 max-w-[40ch] text-white/85">We work Topsail Sound, the ICW, and the canals around Hampstead and Topsail Island.</p>
      </div>
      <ul class="grid gap-x-8 sm:grid-cols-2">
        {B.areas.map((a) => (
          <li class="flex items-center justify-between border-b border-white/20 py-4 font-display text-2xl font-medium md:text-3xl">
            {a.areaPage ? <a href={a.areaPage} class="text-white no-underline hover:underline">{a.name}</a> : <span>{a.name}</span>}
            <span class="text-sm font-normal text-white/65">NC</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {B.reviews.length > 0 && (
    <section class="bg-shallow">
      <div class="container-x py-20">
        <h2 class="text-4xl">What waterfront homeowners say</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {B.reviews.slice(0, 5).map((r) => (
            <figure class="rounded-[18px] border border-rule bg-card p-6">
              <blockquote class="text-lg">"{r.text}"</blockquote>
              <figcaption class="mt-4 text-sm font-semibold">{r.name}, {r.town} <span class="font-normal text-muted">via {r.source}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 8. FAQ -->
  <section class="border-t border-rule">
    <div class="container-x grid gap-10 py-20 md:grid-cols-[1fr_2fr] md:py-24">
      <div>
        <h2 class="text-4xl">Common questions</h2>
        <p class="mt-4 text-sm text-muted">Permit answers are general information, not legal advice. <a href="/faq/" class="link">All questions</a></p>
      </div>
      <FaqList faqs={homeFaqs} heading="Frequently asked questions about docks and permits" id="home-faq" hideHeading />
    </div>
  </section>

  <!-- 9. Estimate card -->
  <div class="p-2 sm:p-3">
    <section class="chart-grid rounded-[22px] bg-night text-white">
      <div class="container-x grid gap-12 py-16 lg:grid-cols-[1fr_1.1fr] lg:py-20">
        <div>
          <h2 class="text-4xl text-white md:text-5xl">Request a free estimate</h2>
          <p class="mt-5 max-w-[46ch] text-white/80">Call us or use the form. Tell us about the dock you want, and we'll send an estimate.</p>
          <a href={telHref()} class="btn-marker mt-8 text-lg" data-event="click_to_call" data-location="home_form"><Icon name="phone" /><span class="tabular-nums">Call {B.phones.office.display}</span></a>
          <p class="mt-3 text-sm text-white/70">Calling is the fastest way to reach us.</p>
        </div>
        <div class="text-ink"><EstimateForm variant="short" /></div>
      </div>
    </section>
  </div>
</BaseLayout>
