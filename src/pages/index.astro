---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Fact from '../components/Fact.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import PlanSchematic from '../components/PlanSchematic.astro';
import { business, telHref } from '../data/business';
import { homeFaqs } from '../data/faqs';
import { gallery } from '../data/gallery';
import { faqSchema } from '../lib/schema';

const B = business;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');
const featured = projects.find((p) => p.id === 'north-topsail-beach-seawall-dock-lifts')!;
const [hero, ...recent] = gallery;

const steps = [
  { t: 'Site visit', d: 'We walk the shoreline with you, check depth at low tide and access for equipment, and talk about how you use the water.' },
  { t: 'Plans & permits', d: 'Engineered plans, a written estimate, and a clear path through CAMA and local permits.' },
  { t: 'Build', d: 'Pilings, framing, decking, lifts and finish work by our own crew.' },
  { t: 'Walk-through', d: 'We go over the finished work with you and cover care and maintenance.' },
];
---
<BaseLayout
  title="Dock, Boat Lift & Seawall Builder in Wilmington, NC | NCMC"
  description="Licensed and insured marine contractor building docks, boat lifts, floating docks and seawalls in Wilmington and coastal NC. Call (910) 465-1712."
  schema={[faqSchema(homeFaqs)]}
>
  <!-- Hero: real work, plainly stated -->
  <section class="container-x grid gap-10 pb-14 pt-10 md:grid-cols-[1.2fr_1fr] md:items-center md:gap-14 md:pb-20 md:pt-16">
    <div class="min-w-0">
      <p class="label-note">Marine contractor · Wilmington to Topsail</p>
      <h1 class="mt-4 text-[2.5rem] sm:text-[3.25rem] lg:text-[3.6rem]">Docks, boat lifts &amp; seawalls built for the Carolina coast.</h1>
      <p class="mt-6 max-w-[48ch] text-lg text-ink/85">
        Licensed and insured. We build from engineered plans and handle the job from the first piling to the last deck board.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={telHref()} class="btn-primary text-lg" data-event="click_to_call" data-location="hero"><Icon name="phone" /><span class="tabular-nums">Call {B.phones.office.display}</span></a>
        <a href="/contact/#estimate" class="btn-secondary text-lg" data-event="estimate_cta" data-location="hero">Get a free estimate</a>
      </div>
      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-ink pt-5 sm:grid-cols-4">
        <div><dt class="label-note">License</dt><dd class="mt-1 text-sm font-semibold">NC GC #<Fact value={B.license.number} /></dd></div>
        <div><dt class="label-note">Insured</dt><dd class="mt-1 text-sm font-semibold">Fully insured</dd></div>
        <div><dt class="label-note">Since</dt><dd class="mt-1 text-sm font-semibold"><Fact value={B.yearFounded} /></dd></div>
        <div><dt class="label-note">Google</dt><dd class="mt-1 text-sm font-semibold">{B.googleRating ? `${B.googleRating.rating} ★ (${B.googleRating.count})` : <span class="todo">TODO_CONFIRM: rating</span>}</dd></div>
      </dl>
    </div>
    <figure class="relative min-w-0">
      <Image src={hero.src} alt={hero.alt} widths={[560, 740]} sizes="(min-width: 768px) 48vw, 100vw" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full object-cover" />
      <figcaption class="mt-3 flex justify-between gap-4 font-mono text-xs text-muted"><span>{hero.caption}</span><span class="todo shrink-0">TODO_CONFIRM: town</span></figcaption>
    </figure>
  </section>

  <!-- Services -->
  <section class="border-t border-rule bg-paper">
    <div class="container-x grid gap-10 py-16 md:grid-cols-[0.8fr_2fr] md:py-20">
      <div>
        <p class="label-note">What we build</p>
        <h2 class="mt-3 text-4xl md:text-5xl">Everything between the yard and the channel.</h2>
        <p class="mt-4 text-muted">One crew for the seawall, the pier, the lift and the repairs later on.</p>
      </div>
      <div class="grid gap-x-8 sm:grid-cols-2">
        {services.map((s) => <ServiceCard href={`/services/${s.id}/`} name={s.data.name} summary={s.data.cardSummary} />)}
      </div>
    </div>
  </section>

  <!-- Featured project as a plan sheet -->
  <section class="bg-shallow">
    <div class="container-x grid gap-10 py-16 md:grid-cols-[1.25fr_1fr] md:items-start md:py-20">
      <div class="min-w-0 border border-ink/20 bg-paper p-3 sm:p-5">
        <PlanSchematic />
      </div>
      <div class="min-w-0">
        <p class="label-note">Project · {featured.data.town}, NC</p>
        <h2 class="mt-3 text-3xl md:text-4xl">{featured.data.title}</h2>
        <p class="mt-4 text-ink/85">{featured.data.summary}</p>
        <table class="mt-6 w-full text-left text-[0.95rem]">
          <tbody>
            {featured.data.specs.map((s) => (
              <tr class="border-t border-ink/20"><th scope="row" class="w-32 py-2.5 pr-4 align-top font-mono text-xs font-medium uppercase tracking-[0.1em] text-tide">{s.label}</th><td class="py-2.5">{s.value}</td></tr>
            ))}
          </tbody>
        </table>
        <a href={`/projects/${featured.id}/`} class="btn-primary mt-8">Read the project</a>
      </div>
    </div>
  </section>

  <!-- Process: a real sequence -->
  <section class="container-x py-16 md:py-20">
    <p class="label-note">How a project runs</p>
    <h2 class="mt-3 max-w-[22ch] text-4xl md:text-5xl">From first call to the finished dock.</h2>
    <ol class="mt-10 grid gap-8 md:grid-cols-4 md:gap-6">
      {steps.map((s, i) => (
        <li class="border-t-2 border-ink pt-4">
          <span class="font-mono text-xs uppercase tracking-[0.12em] text-tide">Step {i + 1}</span>
          <h3 class="mt-2 text-xl">{s.t}</h3>
          <p class="mt-2 text-[0.95rem] text-muted">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Recent work -->
  <section class="border-t border-rule">
    <div class="container-x py-16 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="label-note">Recent work</p>
          <h2 class="mt-3 text-4xl md:text-5xl">Built by our crew.</h2>
        </div>
        <a href="/projects/" class="link">All projects</a>
      </div>
      <ul class="mt-8 grid gap-6 sm:grid-cols-3">
        {recent.map((g) => (
          <li class="min-w-0">
            <figure>
              <Image src={g.src} alt={g.alt} widths={[400, 740]} sizes="(min-width: 640px) 33vw, 100vw" class="aspect-[4/5] w-full object-cover" />
              <figcaption class="mt-2 text-sm text-muted">{g.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Service area -->
  <section class="bg-tide text-white">
    <div class="container-x grid gap-10 py-16 md:grid-cols-[1fr_1.2fr] md:py-20">
      <div>
        <p class="label-note text-white/70">Service area</p>
        <h2 class="mt-3 text-4xl text-white md:text-5xl">Cape Fear River to the New River.</h2>
        <p class="mt-4 max-w-[46ch] text-white/80">We build on the Intracoastal Waterway, the sounds and the tidal creeks of southeastern North Carolina.</p>
      </div>
      <div>
        <ul class="grid grid-cols-1 border-t border-white/30 sm:grid-cols-2 sm:gap-x-8">
          {B.areas.map((a) => (
            <li class="border-b border-white/30 py-3">
              {a.areaPage ? <a href={a.areaPage} class="font-semibold text-white">{a.name}</a> : <span class="font-semibold">{a.name}</span>}
              {a.note && <span class="block text-sm text-white/70">{a.note}</span>}
            </li>
          ))}
        </ul>
        {!B.areasConfirmed && <p class="mt-3 text-sm"><span class="todo">TODO_CONFIRM: town list and priority</span></p>}
      </div>
    </div>
  </section>

  {B.reviews.length > 0 && (
    <section class="container-x py-16">
      <p class="label-note">Reviews</p>
      <h2 class="mt-3 text-4xl">What waterfront homeowners say</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {B.reviews.slice(0, 5).map((r) => (
          <figure class="border-t-2 border-ink pt-4">
            <blockquote class="text-[0.95rem]">"{r.text}"</blockquote>
            <figcaption class="mt-3 text-sm font-semibold">{r.name}, {r.town} <span class="font-normal text-muted">via {r.source}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="container-x grid gap-10 py-16 md:grid-cols-[0.8fr_2fr] md:py-20">
    <div>
      <p class="label-note">Before you call</p>
      <p class="mt-3 text-sm text-muted">Permit answers are general information, not legal advice. <a href="/faq/" class="link">All questions</a></p>
    </div>
    <FaqList faqs={homeFaqs} />
  </section>

  <CtaBand />
</BaseLayout>
