---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Marine Construction Services | Topsail Island & Hampstead"
  description="Docks, piers, boat lifts and vinyl seawalls around Topsail Island and Hampstead, NC. (910) 465-1712"
  breadcrumbs={[{ name: 'Services', href: '/services/' }]}
>
  <section class="container-x py-10 md:py-14">
    <h1 class="text-4xl md:text-6xl">Marine Construction Services</h1>
    <p class="answer-first mt-5">We build and repair docks, piers, boat lifts and vinyl seawalls for waterfront homes around Topsail Island and Hampstead. Tell us how you want to use the water, and we'll build something that makes that easy.</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => <ServiceCard href={`/services/${s.id}/`} name={s.data.name} summary={s.data.cardSummary} />)}
    </div>
  </section>
  <CtaBand />
</BaseLayout>
