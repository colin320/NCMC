---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import FaqList from '../../components/FaqList.astro';
import EstimateForm from '../../components/EstimateForm.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ConfirmNote from '../../components/ConfirmNote.astro';
import CtaBand from '../../components/CtaBand.astro';
import { business, telHref } from '../../data/business';
import { serviceSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service } = Astro.props;
const d = service.data;
const { Content } = await render(service);
const all = await getCollection('services');
const related = d.related.map((id) => all.find((s) => s.id === id)).filter(Boolean);
const projects = (await getCollection('projects')).filter((p) => p.data.services.some((s) => d.projectTags.includes(s)));
const url = new URL(Astro.url.pathname, Astro.site).toString();

const formPreselect: Record<string, string> = {
  'docks-piers': 'dock', 'floating-docks': 'floating-dock', 'boat-lifts': 'boat-lift',
  'jet-ski-lifts': 'pwc-lift', 'seawalls-bulkheads': 'seawall', 'dock-repair': 'repair',
};
---
<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  breadcrumbs={[{ name: 'Services', href: '/services/' }, { name: d.name, href: `/services/${service.id}/` }]}
  schema={[serviceSchema({ name: d.name, serviceType: d.serviceType, url, description: d.answer }), faqSchema(d.faqs)]}
  ogImage={d.image}
>
  <ConfirmNote note={d.confirmNote} />
  <section class="container-x grid gap-10 pb-12 pt-8 md:grid-cols-[1.2fr_1fr] md:items-start md:pb-16 md:pt-10">
    <div class="min-w-0">
      <p class="label-note">Service · Topsail Island &amp; Hampstead</p>
      <h1 class="mt-4 text-4xl md:text-[3.5rem]">{d.h1}</h1>
      <p class="answer-first mt-6">{d.answer}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={telHref()} class="btn-primary" data-event="click_to_call" data-location="service_hero"><Icon name="phone" /><span class="tabular-nums">Call {business.phones.office.display}</span></a>
        <a href="#estimate" class="btn-secondary" data-event="estimate_cta" data-location="service_hero">Free estimate</a>
      </div>
    </div>
    {d.image ? (
      <Image src={d.image} alt={d.imageAlt ?? ''} widths={[400, 740]} sizes="(min-width: 768px) 42vw, 100vw" loading="eager" class="aspect-[4/3] w-full min-w-0 object-cover" />
    ) : (
      <aside class="min-w-0 border-t-2 border-ink pt-4">
        <p class="label-note">What drives the price</p>
        <ul class="mt-3 divide-y divide-rule">
          {d.costDrivers.map((c) => <li class="py-2 text-[0.95rem]">{c}</li>)}
        </ul>
      </aside>
    )}
  </section>

  <section class="border-y border-rule bg-shallow">
    <div class="container-x grid gap-12 py-14 md:grid-cols-2">
      <div class="min-w-0">
        <h2 class="text-3xl">What's included?</h2>
        <ul class="mt-5 border-t border-ink/20">
          {d.included.map((i) => <li class="flex gap-3 border-b border-ink/20 py-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-sea" />{i}</li>)}
        </ul>
      </div>
      <div class="min-w-0">
        <h2 class="text-3xl">How much does it cost?</h2>
        <p class="mt-4">Every waterfront is different, so we price each project after a free site visit. <span class="todo">TODO_CONFIRM: publishable price range or "starting at" figure</span></p>
        {d.image && (
          <Fragment>
            <h3 class="mt-6 text-lg">What drives the price?</h3>
            <ul class="mt-2 list-disc space-y-1 pl-6 marker:text-sea">
              {d.costDrivers.map((c) => <li>{c}</li>)}
            </ul>
          </Fragment>
        )}
      </div>
    </div>
  </section>

  <section class="container-x py-14">
    <div class="prose-ncmc"><Content /></div>
    <aside class="mt-12 max-w-[68ch] border-l-2 border-tide pl-5">
      <p class="label-note">Permits</p>
      <h2 class="mt-2 text-2xl">Do I need a permit?</h2>
      <p class="mt-2">Most marine construction in North Carolina's 20 coastal counties falls under the Coastal Area Management Act (CAMA), administered by the NC Division of Coastal Management. Some storm and wear replacements to the prior footprint are now exempt. We explain the permit path for your property at the estimate visit. <a href="/faq/#permits" class="link">Read our permit FAQs</a>. This is general information, not legal advice.</p>
    </aside>
  </section>

  {projects.length > 0 && (
    <section class="border-t border-rule">
      <div class="container-x py-14">
        <h2 class="text-3xl">Related projects</h2>
        <div class="mt-6 grid gap-8 md:grid-cols-3">
          {projects.map((p) => <ProjectCard href={`/projects/${p.id}/`} title={p.data.title} town={p.data.town} summary={p.data.summary} photo={p.data.photos[0]} />)}
        </div>
      </div>
    </section>
  )}

  <div class="border-t border-rule">
    <div class="container-x grid gap-12 py-14 lg:grid-cols-2">
      <div class="min-w-0"><FaqList faqs={d.faqs} heading={`${d.name}: common questions`} /></div>
      <div class="min-w-0"><EstimateForm variant="short" preselect={formPreselect[service.id]} /></div>
    </div>
  </div>

  <section class="container-x pb-16">
    <p class="label-note">Related services</p>
    <ul class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
      {related.map((r) => r && <li><a href={`/services/${r.id}/`} class="link text-lg">{r.data.name}</a></li>)}
    </ul>
  </section>

  <CtaBand />
</BaseLayout>
