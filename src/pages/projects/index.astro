---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { gallery } from '../../data/gallery';
import { imageGallerySchema } from '../../lib/schema';
import { galleryImageUrls } from '../../lib/gallery-images';
const projects = await getCollection('projects');
const galleryLd = imageGallerySchema('NC Marine Construction project photos', new URL('/projects/', Astro.site).toString(), await galleryImageUrls(Astro.site!));
---
<BaseLayout
  title="Dock, Lift & Seawall Projects | NC Marine Construction"
  description="Docks, boat lifts and seawalls we built in Hampstead and on Topsail Island, with the specs. (910) 465-1712"
  breadcrumbs={[{ name: 'Projects', href: '/projects/' }]}
  schema={[galleryLd]}
>
  <section class="container-x py-10 md:py-14">
    <h1 class="text-4xl md:text-6xl">Dock, Lift &amp; Seawall Projects</h1>
    <p class="answer-first mt-5">These are docks, lifts and seawalls we built in Hampstead, Surf City, Topsail Beach and North Topsail Beach. Each one lists what we built and the materials we used.</p>

    <h2 class="mt-12 text-3xl">Case studies</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {projects.map((p) => <ProjectCard href={`/projects/${p.id}/`} title={p.data.title} town={p.data.town} summary={p.data.summary} photo={p.data.photos[0]} />)}
    </div>

    <h2 class="mt-14 text-3xl">Recent work</h2>
    <p class="mt-2 text-muted">More case studies are coming. <span class="todo">TODO_CONFIRM: every photo is NCMC's own work</span></p>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {gallery.map((g) => (
        <li>
          <figure>
            <Image src={g.src} alt={g.alt} widths={[400, 740]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
            <figcaption class="mt-2 text-sm text-muted">{g.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
  <CtaBand heading="Get a price on a project like this." />
</BaseLayout>
