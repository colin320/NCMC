---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import Fact from '../components/Fact.astro';
import Icon from '../components/Icon.astro';
import { business, telHref, smsHref } from '../data/business';
const B = business;
---
<BaseLayout
  title="Contact NC Marine Construction | Free On-Site Estimate"
  description="Free on-site estimate for a dock or boat lift in Surf City, Hampstead or Topsail Beach, NC. Call (910) 465-1712 or use the form."
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
>
  <section class="container-x py-10 md:py-14">
    <h1 class="text-4xl md:text-6xl">Free on-site estimate</h1>
    <p class="answer-first mt-5">Calling {B.phones.office.display} is the fastest way to reach us. You can also use the form. We'll set a time to come out, check the water depth, and talk through the job.</p>

    <div id="form-error" class="mt-6 hidden max-w-3xl rounded-sm border-l-4 border-red-600 bg-red-950/50 p-4" role="alert">
      Sorry, your request did not go through. Please call <a class="font-semibold underline" href={telHref()}>{B.phones.office.display}</a> or try the form again.
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3"><EstimateForm /></div>
      <aside class="space-y-6 lg:col-span-2">
        <div class="rounded-sm bg-night p-6 text-white">
          <h2 class="text-3xl text-white">Call or text</h2>
          <div class="mt-4 flex flex-col gap-3">
            <a href={telHref()} class="btn-marker text-lg" data-event="click_to_call" data-location="contact"><Icon name="phone" />Call {B.phones.office.display}</a>
            <a href={smsHref()} class="btn-ghost-light" data-event="click_to_text" data-location="contact"><Icon name="text" />Text {B.phones.text.display}</a>
          </div>
          {B.phones.publishMobile && <p class="mt-3 text-sm">Mobile: <a class="underline" href={telHref(B.phones.mobile)}>{B.phones.mobile.display}</a></p>}
          <p class="mt-4 text-sm text-white/80">Email: <a class="text-white underline" href={`mailto:${B.email}`}>{B.email}</a></p>
        </div>
        <div class="rounded-sm border border-rule bg-card p-6">
          <h2 class="text-2xl">Office</h2>
          <address class="mt-2 not-italic">
            {B.legalName}<br />
            <Fact value={B.address.street} /><br />
            <Fact value={B.address.city} />, {B.address.region} <Fact value={B.address.postalCode} />
          </address>
          <h2 class="mt-5 text-2xl">Hours</h2>
          {B.hours.length ? <ul>{B.hours.map((h) => <li>{h.days}: {h.opens} to {h.closes}</li>)}</ul> : <p><Fact value={B.hoursText} /></p>}
          <h2 class="mt-5 text-2xl">Service area</h2>
          <p>{B.serviceAreaSummary}: {B.areas.map((a) => a.name).join(', ')}.</p>
        </div>
      </aside>
    </div>
  </section>
  <script>
    if (new URLSearchParams(location.search).has('error')) document.getElementById('form-error')?.classList.remove('hidden');
  </script>
</BaseLayout>
